config_version=5

[application]

config/name="Movie Creator"
run/main_scene="res://scenes/editor.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Android-first portrait 3D cutscene editor"

[display]

window/size/viewport_width=432
window/size/viewport_height=960
window/size/window_width_override=432
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.12, 1)

[input_devices]

pointing/emulate_mouse_from_touch=false
